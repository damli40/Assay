# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Network switch ---
# The host serves one chain per process: testnet (10143) or mainnet (143).
# Any setting below can be given per network as NAME_TESTNET / NAME_MAINNET; that wins over plain NAME.
ASSAY_NETWORK=testnet

# --- Upstream model ---
OPENROUTER_API_KEY=
UPSTREAM_MODEL=qwen/qwen3.8-27b:free
UPSTREAM_PROVIDER=
# Any OpenAI-compatible chat-completions URL instead of OpenRouter, with its own key.
UPSTREAM_URL=
UPSTREAM_API_KEY=

# --- RPCs ---
# Primary per network (e.g. a QuickNode endpoint). The network's public RPC is added as the fallback
# automatically, or set MONAD_RPC_URL_2_<NETWORK> to choose another.
MONAD_RPC_URL_TESTNET=
MONAD_RPC_URL_MAINNET=

# --- Contracts and identity, per network ---
ANCHOR_ADDRESS_TESTNET=0x63e4F42E6d254ed6aAE735F9F4169BbFd12c1a24
ANCHOR_ADDRESS_MAINNET=
HOST_AGENT_ID_TESTNET=1962
HOST_AGENT_ID_MAINNET=
# Testnet defaults to the deployed VerifierRegistry; mainnet must be set after the mainnet deploy.
VERIFIER_REGISTRY_MAINNET=

# --- Host relayer ---
# Hot key that pays gas for anchor and co-sign transactions. Keep only a small balance on it.
RELAYER_PRIVATE_KEY=
PORT=8787
BATCH_SECONDS=300
BATCH_MAX=64

# --- Tenderly (debugging and simulation) ---
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=

# --- Envio (HyperSync token for local indexer runs and indexer/scripts/hypersync_stats.py) ---
ENVIO_API_TOKEN=
