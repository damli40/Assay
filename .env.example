# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Upstream model (reference host, Day 5) ---
OPENROUTER_API_KEY=
UPSTREAM_MODEL=qwen/qwen3.8-27b:free
UPSTREAM_PROVIDER=

# --- Monad testnet RPCs (host uses both through viem fallback) ---
# Primary: QuickNode endpoint URL. Backup: Dwellir or Crouton endpoint URL.
MONAD_RPC_URL=
MONAD_RPC_URL_2=https://testnet-rpc.monad.xyz

# --- Host relayer (Day 5) ---
# Testnet-only key that pays gas for anchor and cosign transactions. Never reuse a mainnet key.
RELAYER_PRIVATE_KEY=
HOST_AGENT_ID=
ANCHOR_ADDRESS=
PORT=8787
BATCH_SECONDS=300
BATCH_MAX=64

# --- Tenderly (debugging and simulation) ---
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=

# --- Envio (Day 8 indexer) ---
ENVIO_API_TOKEN=
