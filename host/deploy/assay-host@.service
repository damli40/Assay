[Unit]
Description=Assay host on Monad %i (OpenAI-compatible proxy that signs receipts)
After=network-online.target
Wants=network-online.target

[Service]
User=assay
WorkingDirectory=/opt/assay/host
# One instance per network: assay-host@testnet (port 8787) and assay-host@mainnet (port 8788).
EnvironmentFile=/etc/assay/host-%i.env
ExecStart=/opt/assay/host/node_modules/.bin/tsx src/server.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
