# Copy the variables you need into the repo root .env (gitignored). The host reads ../.env.
OPENROUTER_API_KEY=
UPSTREAM_MODEL=z-ai/glm-5.3
# OpenRouter provider slug to pin. Leave empty for free models with a single provider.
UPSTREAM_PROVIDER=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_RPC_URL_2=
ANCHOR_ADDRESS=0x63e4F42E6d254ed6aAE735F9F4169BbFd12c1a24
HOST_AGENT_ID=1962
# Pays anchor and co-sign gas. Needs no special role: authority comes from the host key's signature.
RELAYER_PRIVATE_KEY=
HOST_JWK_PATH=.keys/host.jwk.json
RETIRED_JWK_PATHS=
BATCH_SECONDS=300
BATCH_MAX=64
PORT=8787
PUBLIC_URL=
# Only for scripts/register-agent.ts: the key that owns the ERC-8004 agent.
OWNER_PRIVATE_KEY=
